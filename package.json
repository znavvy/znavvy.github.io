{
  "name": "znavvy-frontend",
  "type": "module",
  "version": "1.0.0",
  "description": "ZNavvy V2 frontend — Astro + TypeScript + Tailwind CSS v4",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro build && node scripts/postbuild.mjs",
    "preview": "astro preview --host 127.0.0.1 --port 4322",
    "typecheck": "astro check",
    "gen-api": "python scripts/generate_api_data.py",
    "gen-synthetic": "python scripts/generate_synthetic_catalog.py",
    "gen-full": "npm run gen-api && astro build",
    "test": "node --test tests/frontend.test.mjs",
    "test:browser": "node scripts/test_browser_flow.mjs",
    "benchmark": "node scripts/benchmark_synthetic.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.1.2",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^22.10.1",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.5",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=9.6.5"
  }
}
