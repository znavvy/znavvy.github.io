---
/**
 * product/index.astro — Generic product detail shell (query-param based)
 *
 * URL: /product/?id=Samsung_Galaxy_S25&v=256GB
 * The ?id= param is read by client JS; ?v= sets preselected variant.
 *
 * For static per-product pages with specific metadata, see [id].astro.
 * This generic shell handles cases where /product/?id= is linked directly.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';
---

<BaseLayout
  title="Detail Produk — ZNavvy"
  description="Bandingkan penawaran dari berbagai marketplace untuk produk yang kamu pilih."
  canonicalPath="/product/"
>
  <div class="mx-auto max-w-4xl px-4 pb-16 pt-6 overflow-x-hidden">
    <!-- Breadcrumb -->
    <nav class="mb-6 text-sm text-gray-500" aria-label="Navigasi">
      <a href="/" class="hover:text-teal-600 transition-colors">← Kembali ke katalog</a>
    </nav>

    <!-- Loading skeleton -->
    <div id="product-skeleton">
      <div class="flex flex-col gap-6 sm:flex-row">
        <div class="skeleton h-48 w-full rounded-xl sm:h-64 sm:w-64 flex-shrink-0"></div>
        <div class="flex-1">
          <div class="skeleton mb-2 h-7 w-3/4 rounded"></div>
          <div class="skeleton mb-4 h-4 w-1/3 rounded"></div>
          <div class="flex gap-2 mb-6">
            <div class="skeleton h-8 w-24 rounded-full"></div>
            <div class="skeleton h-8 w-28 rounded-full"></div>
          </div>
          <div class="skeleton h-5 w-1/2 rounded"></div>
          <div class="skeleton mt-2 h-4 w-2/3 rounded"></div>
        </div>
      </div>
      <div class="mt-6 skeleton h-40 w-full rounded-xl"></div>
    </div>

    <!-- Error state -->
    <div id="product-error" class="hidden rounded-xl border border-red-200 bg-red-50 p-8 text-center">
      <p class="font-medium text-red-700">Produk tidak ditemukan</p>
      <p id="product-error-message" class="mt-1 text-sm text-red-600"></p>
      <a href="/" class="mt-4 inline-block text-sm text-teal-600 underline hover:text-teal-700">
        Kembali ke katalog
      </a>
    </div>

    <!-- Product detail (rendered by client JS) -->
    <article id="product-detail" class="hidden">
      <!-- Header -->
      <div class="flex flex-col gap-6 sm:flex-row">
        <!-- Product image -->
        <div class="flex-shrink-0">
          <div class="relative h-48 w-full overflow-hidden rounded-xl bg-gray-100 sm:h-64 sm:w-64">
            <img
              id="product-image"
              src=""
              alt=""
              loading="lazy"
              class="h-full w-full object-contain p-3"
            />
            <div id="product-image-placeholder" class="img-placeholder absolute inset-0 flex items-center justify-center">
              <span class="text-sm text-gray-400">Gambar tidak tersedia</span>
            </div>
          </div>
        </div>

        <!-- Product info -->
        <div class="flex-1 min-w-0">
          <span id="product-category" class="inline-block rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-600 mb-2"></span>
          <h1 id="product-title" class="text-xl font-bold text-gray-900 sm:text-2xl leading-tight"></h1>

          <!-- Variant selector -->
          <div class="mt-4">
            <p class="mb-2 text-sm font-medium text-gray-700">Pilih varian:</p>
            <div id="variant-chips" class="flex flex-wrap gap-2"></div>
          </div>

          <!-- Price for selected variant -->
          <div class="mt-5 rounded-lg bg-teal-50 border border-teal-100 px-4 py-3">
            <p class="text-xs text-teal-700 font-medium mb-0.5">Harga saat terakhir diperiksa</p>
            <p id="selected-price" class="text-2xl font-bold text-teal-700"></p>
            <p id="snapshot-date" class="mt-0.5 text-xs text-gray-500"></p>
          </div>
        </div>
      </div>

      <!-- Offers section -->
      <section class="mt-8">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-base font-semibold text-gray-900">
            Penawaran untuk <span id="selected-variant-label" class="text-teal-700"></span>
          </h2>
          <span id="offers-count-label" class="text-sm text-gray-500"></span>
        </div>

        <div id="offers-list" class="flex flex-col gap-2.5"></div>

        <div id="offers-empty" class="hidden rounded-xl border border-gray-200 bg-gray-50 py-8 text-center">
          <p class="text-sm text-gray-500">Tidak ada penawaran untuk varian ini</p>
        </div>
      </section>

      <!-- Pricing disclaimer -->
      <p class="mt-6 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-xs text-amber-800">
        Harga di atas dicatat saat pemeriksaan terakhir, <strong>bukan harga langsung</strong>.
        Harga aktual bisa berbeda. Selalu verifikasi langsung di marketplace sebelum membeli.
      </p>

      <!-- Data notice -->
      <div id="scrape-date-notice" class="mt-3 text-xs text-gray-400 text-right hidden">
        Data dikumpulkan: <span id="scrape-date-value"></span>
      </div>
    </article>
  </div>

  <!-- Product detail client script -->
  <script>
    import '../../scripts/product.ts';
  </script>
</BaseLayout>
